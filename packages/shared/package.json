{
  "name": "@od/shared",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "react-native": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./schemas": {
      "types": "./dist/schemas/index.d.ts",
      "react-native": "./src/schemas/index.ts",
      "default": "./dist/schemas/index.js"
    },
    "./types": {
      "types": "./dist/types/index.d.ts",
      "react-native": "./src/types/index.ts",
      "default": "./dist/types/index.js"
    },
    "./table": {
      "types": "./dist/table/index.d.ts",
      "react-native": "./src/table/index.ts",
      "default": "./dist/table/index.js"
    },
    "./time": {
      "types": "./dist/time/index.d.ts",
      "react-native": "./src/time/index.ts",
      "default": "./dist/time/index.js"
    },
    "./client": {
      "types": "./dist/client/index.d.ts",
      "react-native": "./src/client/index.ts",
      "default": "./dist/client/index.js"
    },
    "./constants": {
      "types": "./dist/constants.d.ts",
      "react-native": "./src/constants.ts",
      "default": "./dist/constants.js"
    },
    "./errors": {
      "types": "./dist/errors.d.ts",
      "react-native": "./src/errors.ts",
      "default": "./dist/errors.js"
    },
    "./recurrence": {
      "types": "./dist/recurrence/index.d.ts",
      "react-native": "./src/recurrence/index.ts",
      "default": "./dist/recurrence/index.js"
    },
    "./notifications": {
      "types": "./dist/notifications/index.d.ts",
      "react-native": "./src/notifications/index.ts",
      "default": "./dist/notifications/index.js"
    },
    "./activity": {
      "types": "./dist/activity/index.d.ts",
      "react-native": "./src/activity/index.ts",
      "default": "./dist/activity/index.js"
    },
    "./lists": {
      "types": "./dist/lists/index.d.ts",
      "react-native": "./src/lists/index.ts",
      "default": "./dist/lists/index.js"
    },
    "./test-fixtures": {
      "types": "./dist/test-fixtures/index.d.ts",
      "react-native": "./src/test-fixtures/index.ts",
      "default": "./dist/test-fixtures/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b && tsc -p tsconfig.scripts.json && tsc -p tsconfig.test.json",
    "test": "tsc -b && tsc -p tsconfig.test.json && vitest run --exclude '**/scopeGuard.test.ts'",
    "test:guards": "vitest run src/types/scopeGuard.test.ts",
    "gen:openapi": "tsx scripts/gen-openapi.ts"
  },
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "9.1.0",
    "date-fns": "4.1.0",
    "date-fns-tz": "3.2.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "fast-check": "3.23.2",
    "openapi3-ts": "4.6.1",
    "tsx": "4.23.11",
    "vitest": "3.2.7"
  }
}
