# Every variable the API reads, with placeholder values. The only `.env*` file in git
# (`git-workflow.md` §7).
#
#   cp services/api/.env.example services/api/.env.local
#
# `.env.local` is git-ignored and is what `pnpm --filter @od/api dev` loads. The values
# below are already correct for a laptop, so the copy needs no editing in Phase 0.
#
# These are identifiers and endpoints. No secret belongs in this file or in any `.env`
# (`security-privacy.md` §6.2) — from Phase 4, real secrets live in SSM Parameter Store and
# are read by the Lambda at runtime, never baked into an environment.

# local | dev | prod. Selects behaviour that genuinely differs, never a code path.
STAGE=local

# local | cognito. Which IdentityProvider the API runs (P1-01).
#
# There is NO DEFAULT: an unset value throws at startup. A default of `local` would mean a
# deployed API silently treating every caller in the world as `usr_local_dev`, so every
# environment states its mode rather than inheriting one.
AUTH_MODE=local

# trace | debug | info | warn | error | fatal
LOG_LEVEL=debug

# od-main-<stage>. One speller lives in @od/shared/table.
TABLE_NAME=od-main-local

# Set ONLY on a laptop. Its presence is the single permitted local-vs-deployed branch in
# runtime code; deployed stages leave it unset and reach real DynamoDB.
DDB_ENDPOINT=http://localhost:8000

AWS_REGION=us-east-1

# DynamoDB Local requires credentials to be PRESENT, not valid. These literal strings are
# correct. Omitting them produces a confusing `CredentialsProviderError` that reads like a
# misconfigured AWS profile rather than like the missing local placeholder it is.
AWS_ACCESS_KEY_ID=local
AWS_SECRET_ACCESS_KEY=localsecret

# The media bucket. Nothing uploads to it until Phase 3 (P3-21 adds MinIO behind this name);
# the API validates the variable at startup regardless, so it is set from the start.
MEDIA_BUCKET=od-media-local
